<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IceAge.Controls.PollOptionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IceAge.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Bind VotePercentageText, Mode=OneWay}" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind OptionText, Mode=OneWay}" Margin="10,0,0,0"/>
        </StackPanel>
        <ProgressBar Value="{x:Bind VotePercentage, Mode=OneWay}" Height="10" Margin="0,5,0,0"/>
        <ToolTipService.ToolTip>
            <ToolTip IsEnabled="True" Content="{x:Bind VotesCountText, Mode=OneWay}"/>
        </ToolTipService.ToolTip>
    </StackPanel>
</UserControl>
