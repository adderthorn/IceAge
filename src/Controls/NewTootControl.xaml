<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IceAge.Controls.NewTootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IceAge.Controls"
    xmlns:converters="using:IceAge.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <converters:InitialsDisplayValueConverter x:Key="InitialsDisplayValueConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <PersonPicture Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Width="50" Margin="5" ProfilePicture="{x:Bind ViewModel.ProfileImageUrl, Mode=OneWay}"
                       DisplayName="{x:Bind ViewModel.Account.DisplayName, Mode=OneWay}"
                       Initials="{x:Bind ViewModel.ProfileImageUrl, Converter={StaticResource InitialsDisplayValueConverter}, Mode=OneWay}"/>
        <TextBox x:Name="ContentTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" AcceptsReturn="True" Margin="0,5,5,5"
                 TextWrapping="Wrap" Text="{x:Bind ViewModel.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2">
            <DropDownButton Margin="5" Width="60" Height="33">
                <DropDownButton.Content>
                    <FontIcon Glyph="{x:Bind ViewModel.SelectedVisibilityGlyph, Mode=OneWay}" FontSize="16"
                              FontFamily="{x:Bind ViewModel.SelectedVisibilityFont, Mode=OneWay}"/>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem x:Uid="VisibilityPublic" Tag="public" Click="MenuFlyoutItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE774;"/>
                            </MenuFlyoutItem.Icon>
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="VisibilityPublicTooltip"/>
                            </ToolTipService.ToolTip>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="VisibilityQuiet" Tag="quiet" Click="MenuFlyoutItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7ED;"/>
                            </MenuFlyoutItem.Icon>
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="VisibilityQuietTooltip"/>
                            </ToolTipService.ToolTip>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="VisibilityFollowers" Tag="followers" Click="MenuFlyoutItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72E;"/>
                            </MenuFlyoutItem.Icon>
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="VisibilityFollowersTooltip"/>
                            </ToolTipService.ToolTip>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="VisibilityPrivate" Tag="private" Click="MenuFlyoutItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe UI" Glyph="@"/>
                            </MenuFlyoutItem.Icon>
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="VisibilityPrivateTooltip"/>
                            </ToolTipService.ToolTip>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Tapped="PhotoButton_Tapped">
                <SymbolIcon Symbol="Pictures"/>
            </Button>
            <Button Margin="5" FontSize="15" FontWeight="Bold" Tapped="HashtagButton_Tapped">
                #
            </Button>
            <Button FontSize="15" FontWeight="Bold" Tapped="MentionButton_Tapped">
                @
            </Button>
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.ContentLength, Mode=OneWay}" Grid.Row="2" Grid.Column="2" Margin="5"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <Button x:Name="PostButton" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Right" Margin="5"
                Style="{StaticResource AccentButtonStyle}" Tapped="PostButton_Tapped">
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="Enter"/>
            </Button.KeyboardAccelerators>
            <ToolTipService.ToolTip>
                <ToolTip>Post (Ctrl + Enter)</ToolTip>
            </ToolTipService.ToolTip>
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Symbol="Send" VerticalAlignment="Center"/>
                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center">Post</TextBlock>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
